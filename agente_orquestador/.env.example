AGENT_NAME=Agente Orquestador Pepe Millan
AGENT_VERSION=0.1.0
AGENT_ENVIRONMENT=development

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_APPROVER_USER_IDS=

CONTEXT_DATABASE_PATH=data/context.db
EXECUTION_WORKSPACE_ROOT=../../Agentes_ejecuciones

SANDBOX_GATEWAY_URL=
SANDBOX_GATEWAY_TOKEN=
SANDBOX_GATEWAY_TIMEOUT_SECONDS=150

PROJECT_NAME=Agente Orquestador
GIT_REPOSITORY=https://github.com/jmillan1955/Agentes.git
PROMOTION_REPOSITORY_ROOT=..
PROMOTION_ALLOWED_PROJECTS={"puntuacion_padel":"puntuacion_padel"}

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERAL_MODEL=llama3.2:3b
OLLAMA_CODING_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CODING_TIMEOUT_SECONDS=900

GENERAL_PROVIDER=openai
PLANNING_PROVIDER=openai
CODING_PROVIDER=ollama
COMPARISON_PROVIDERS=openai,ollama

OPENAI_API_KEY=
OPENAI_GENERAL_MODEL=gpt-5
OPENAI_PLANNING_MODEL=gpt-5
OPENAI_CODING_MODEL=gpt-5-mini
OPENAI_GENERAL_REASONING_EFFORT=minimal
OPENAI_PLANNING_REASONING_EFFORT=low
OPENAI_CODING_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=120
OPENAI_CODING_TIMEOUT_SECONDS=300
OPENAI_INPUT_COST_PER_MILLION=1.25
OPENAI_OUTPUT_COST_PER_MILLION=10
OPENAI_CODING_INPUT_COST_PER_MILLION=0.25
OPENAI_CODING_OUTPUT_COST_PER_MILLION=2

VERIFICATION_ENABLED=true
VERIFICATION_MODE=automatic
OPENAI_VERIFICATION_MODEL=gpt-5-mini
OPENAI_VERIFICATION_REASONING_EFFORT=low
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low
OPENAI_VERIFICATION_INPUT_COST_PER_MILLION=0.25
OPENAI_VERIFICATION_OUTPUT_COST_PER_MILLION=2

GEMINI_API_KEY=
GEMINI_GENERAL_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120

WHISPER_MODEL=small
